{
  "id": "zen-bre",
  "name": "GoRules ZEN Business Rules Engine",
  "description": "Local-first Service Lasso managed HTTP wrapper around the embedded GoRules ZEN engine.",
  "enabled": false,
  "version": "0.1.0",
  "logoutput": true,
  "icon": [
    {
      "provider": "lucide",
      "name": "workflow"
    }
  ],
  "servicetype": 50,
  "servicelocation": 10,
  "endpoints": [
    {
      "name": "http",
      "protocol": "http",
      "bind": "127.0.0.1",
      "allocation": "preferred",
      "preferred": 18089,
      "url": "http://${ENDPOINT_HTTP_HOST}:${ENDPOINT_HTTP_PORT}/"
    }
  ],
  "urls": [
    {
      "label": "api",
      "url": "${ZEN_BRE_URL}",
      "kind": "local"
    }
  ],
  "exports": [
    "ZEN_BRE_URL",
    "ZEN_BRE_DECISIONS_DIR",
    "ZEN_BRE_VERSION"
  ],
  "files": {
    "roots": [
      {
        "id": "decisions",
        "path": "${SERVICE_ROOT}/decisions",
        "description": "Operator-managed JDM JSON files."
      },
      {
        "id": "config",
        "path": "${SERVICE_ROOT}/config",
        "description": "Generated non-secret configuration."
      },
      {
        "id": "logs",
        "path": "${SERVICE_ROOT}/logs",
        "description": "Structured service logs."
      },
      {
        "id": "state",
        "path": "${SERVICE_ROOT}/.state",
        "description": "Compiled registry and reload metadata only."
      }
    ]
  },
  "logs": {
    "default": {
      "path": "logs/zen-bre.log"
    }
  },
  "meta": {
    "developers": [
      {
        "name": "Service Lasso contributors"
      }
    ],
    "license": "Apache-2.0",
    "upstream": {
      "name": "GoRules ZEN",
      "repository": "https://github.com/gorules/zen",
      "crate": "zen-engine",
      "version": "1.0.0-beta.11",
      "license": "MIT"
    },
    "repository": {
      "type": "git",
      "url": "https://github.com/service-lasso/lasso-zen-bre.git"
    },
    "websiteUrl": "https://github.com/service-lasso/lasso-zen-bre",
    "documentationUrl": "https://github.com/service-lasso/lasso-zen-bre/blob/develop/README.md",
    "issuesUrl": "https://github.com/service-lasso/lasso-zen-bre/issues",
    "support": {
      "issuesUrl": "https://github.com/service-lasso/lasso-zen-bre/issues"
    },
    "links": {
      "repository": "https://github.com/service-lasso/lasso-zen-bre",
      "issues": "https://github.com/service-lasso/lasso-zen-bre/issues",
      "documentation": "https://github.com/service-lasso/lasso-zen-bre/blob/develop/README.md",
      "upstream": "https://github.com/gorules/zen"
    },
    "tags": [
      "service-lasso",
      "decision-service",
      "business-rules",
      "gorules",
      "zen-engine"
    ]
  },
  "artifact": {
    "kind": "archive",
    "source": {
      "type": "github-release",
      "repo": "service-lasso/lasso-zen-bre",
      "channel": "latest"
    },
    "platforms": {
      "win32": {
        "assetName": "lasso-zen-bre-1.0.0-beta.11-win32.zip",
        "archiveType": "zip",
        "command": "./lasso-zen-bre.exe",
        "args": []
      },
      "linux": {
        "assetName": "lasso-zen-bre-1.0.0-beta.11-linux.tar.gz",
        "archiveType": "tar.gz",
        "command": "./lasso-zen-bre",
        "args": []
      },
      "darwin": {
        "assetName": "lasso-zen-bre-1.0.0-beta.11-darwin.tar.gz",
        "archiveType": "tar.gz",
        "command": "./lasso-zen-bre",
        "args": []
      }
    }
  },
  "actions": {
    "install": {
      "description": "Acquire or unpack the packaged ZEN BRE runtime artifact.",
      "mode": "converge-install",
      "idempotent": true
    },
    "config": {
      "description": "Materialize non-secret ZEN BRE configuration and workspace directories.",
      "mode": "converge-config",
      "idempotent": true
    },
    "validate": {
      "description": "Validate the decision registry without exposing source or inputs.",
      "mode": "runtime-validate",
      "idempotent": true
    },
    "reload": {
      "description": "Rescan and recompile decision files from the decisions workspace.",
      "mode": "runtime-reload",
      "idempotent": false
    },
    "update": {
      "description": "Apply a newer release artifact and reconcile update-time changes before restart.",
      "mode": "converge-update",
      "idempotent": true
    },
    "start": {
      "description": "Start the ZEN BRE HTTP service.",
      "mode": "runtime-start",
      "idempotent": true
    },
    "stop": {
      "description": "Stop the ZEN BRE HTTP service gracefully.",
      "mode": "runtime-stop",
      "idempotent": true
    },
    "restart": {
      "description": "Restart the ZEN BRE service after config, model or update changes.",
      "mode": "runtime-restart",
      "idempotent": false
    },
    "rollback": {
      "description": "Restore the previously deployed artifact if an update fails validation.",
      "mode": "state-rollback",
      "idempotent": false
    }
  },
  "execconfig": {
    "serviceorder": 100,
    "serviceport": 0,
    "execcwd": ".",
    "executable": "lasso-zen-bre",
    "args": [
      "--host",
      "${ENDPOINT_HTTP_HOST}",
      "--port",
      "${ENDPOINT_HTTP_PORT}",
      "--decisions-dir",
      "${SERVICE_ROOT}/decisions"
    ],
    "env": {
      "ZEN_BRE_URL": "http://${ENDPOINT_HTTP_HOST}:${ENDPOINT_HTTP_PORT}",
      "ZEN_BRE_DECISIONS_DIR": "${SERVICE_ROOT}/decisions",
      "ZEN_BRE_VERSION": "0.1.0"
    },
    "globalenv": {
      "ZEN_BRE_URL": "http://${ENDPOINT_HTTP_HOST}:${ENDPOINT_HTTP_PORT}",
      "ZEN_BRE_DECISIONS_DIR": "${SERVICE_ROOT}/decisions",
      "ZEN_BRE_VERSION": "0.1.0"
    },
    "depend_on": []
  },
  "healthchecks": [
    {
      "id": "live",
      "type": "http",
      "url": "${ZEN_BRE_URL}/health/live"
    },
    {
      "id": "ready",
      "type": "http",
      "url": "${ZEN_BRE_URL}/health/ready"
    }
  ]
}
